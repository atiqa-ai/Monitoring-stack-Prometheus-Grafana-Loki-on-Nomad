{
  "uid": "nomad-observability",
  "title": "Nomad Monitoring - Metrics and Logs",
  "tags": ["nomad", "prometheus", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape Target Health (1 = UP)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "up{job=~\"nomad|prometheus\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Nomad Allocated CPU",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "nomad_client_allocated_cpu",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Nomad Allocated Memory",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "nomad_client_allocated_memory",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Nomad Application Logs",
      "type": "logs",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "{job=\"nomad-log-demo\"} |= \"phase3-log-check\"",
          "refId": "A",
          "queryType": "range"
        }
      ]
    }
  ]
}
